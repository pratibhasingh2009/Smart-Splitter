rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidPositiveNumber(val) {
      return (val is int || val is float) && val > 0;
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection:
    // Any authenticated user can read other users (needed to find members, show names/avatars in groups).
    // Users can only create or modify their own user document.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['id', 'name', 'email']) &&
        isValidString(request.resource.data.name, 1, 100) &&
        isValidString(request.resource.data.email, 3, 150);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // 2. Groups Collection:
    // Only group members or creator can read the group document.
    // Creating group requires caller to be in members list and designated as member/creator.
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['id', 'name', 'members']) &&
        isValidString(request.resource.data.name, 1, 100) &&
        (request.auth.uid in request.resource.data.members);
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.members
      );
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.members
      );
    }

    // 3. Expenses Collection:
    // Only payer or group members can read/write expense records.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        resource.data.paidBy == request.auth.uid ||
        (resource.data.groupId != null && resource.data.groupId != 'personal' && isGroupMember(resource.data.groupId)) ||
        (resource.data.splits != null && resource.data.splits.hasAny([{'memberId': request.auth.uid}]))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['id', 'title', 'amount', 'paidBy', 'splits']) &&
        request.resource.data.paidBy == request.auth.uid &&
        isValidPositiveNumber(request.resource.data.amount) &&
        isValidString(request.resource.data.title, 1, 200);
      allow update: if isAuthenticated() && (
        resource.data.paidBy == request.auth.uid ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      allow delete: if isAuthenticated() && resource.data.paidBy == request.auth.uid;
    }

    // 4. Settlements Collection:
    // Either debtor (fromId) or creditor (toId) can view or record payment.
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.fromId == request.auth.uid ||
        request.resource.data.toId == request.auth.uid
      ) && isValidPositiveNumber(request.resource.data.amount);
      allow update: if isAuthenticated() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid
      );
    }

    // 5. Recurring Expenses Collection:
    match /recurringExpenses/{recId} {
      allow read: if isAuthenticated() && (
        resource.data.paidBy == request.auth.uid ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.paidBy == request.auth.uid &&
        isValidPositiveNumber(request.resource.data.amount);
      allow update: if isAuthenticated() && resource.data.paidBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.paidBy == request.auth.uid;
    }

    // 6. Group Chat Messages:
    match /groupMessages/{messageId} {
      allow read: if isAuthenticated() && isGroupMember(resource.data.groupId);
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        isGroupMember(request.resource.data.groupId);
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
  }
}
